{
  "manifest_version": 3,
  "name": "Mask Relay",
  "version": "__VERSION__",
  "description": "Disposable masked email addresses with a private, tracker-blocking inbox. Keep ads and spam out of your real mailbox.",
  "homepage_url": "https://github.com/exexexexe/mask-relay",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "alarms", "notifications", "menus", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["https://api.mail.tm/*"],
  "background": { "scripts": ["core.js", "platform.js", "background.js"] },
  "action": {
    "default_title": "Mask Relay",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "Open Mask Relay" }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mask-relay@exexexexe.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
